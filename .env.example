# Copy to .env for local runs. On GitHub the same names are repository secrets
# (Settings -> Secrets and variables -> Actions); `gh secret set -f .env` uploads them.

# --- Required ---------------------------------------------------------------
# ORCID public API client (https://orcid.org/developer-tools)
ORCID_CLIENT_ID=APP-XXXXXXXXXXXXXXXX
ORCID_CLIENT_SECRET=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Whose record to read
ORCID_ID=0000-0000-0000-0000
# OpenAlex API key (https://openalex.org/settings/api)
OPENALEX_API_KEY=your-openalex-key
# Google Scholar profile id: the user=... part of the profile URL
SCHOLAR_USER_ID=xxxxxxxxxxxx

# --- Recommended ------------------------------------------------------------
# Contact email sent to Crossref (puts requests in its faster "polite" pool)
CROSSREF_MAILTO=you@example.org

# SerpApi key (https://serpapi.com/manage-api-key): fallback when Google Scholar
# blocks the request (usual on GitHub Actions). Leave unset to disable.
SERPAPI_KEY=your-serpapi-key

# --- Optional (defaults shown) ----------------------------------------------
# Max SerpApi searches this pipeline may use per calendar month (UTC)
# SERPAPI_MONTHLY_LIMIT=200
# Skip SerpApi if the account has fewer searches left than this
# SERPAPI_RESERVE=20
# production or sandbox
# ORCID_ENV=production
# Re-fetch OpenAlex records older than this many days (citations change)
# OPENALEX_MAX_AGE_DAYS=7
# Skip the Scholar request if the saved copy is younger than this many hours
# SCHOLAR_MAX_AGE_HOURS=24
